# ============================================================
# Konfigurasi Redis untuk Reservasi Tiket Konser
# ============================================================
# Tambahkan variabel berikut ke file .env Anda.
#
# Jika menggunakan Docker Compose, REDIS_HOST harus sesuai
# dengan nama service Redis di docker-compose.yml (konser_redis).
# Jika menjalankan Redis di lokal, gunakan 127.0.0.1.
# ============================================================

REDIS_CLIENT=phpredis
REDIS_HOST=konser_redis
REDIS_PASSWORD=null
REDIS_PORT=6379
